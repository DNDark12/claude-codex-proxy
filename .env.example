# Server runtime
PROXY_PORT=8080
PROXY_AUTH_PATH=~/.codex/auth.json

# Account Pool (multi-account)
ACCOUNTS_CONFIG_PATH=./accounts.toml
ENABLE_TOKEN_PASTE=true

# Logging
RUST_LOG=info
LOG_PROTOCOL_DEBUG=false

# Tool fallback policy
# false: retry once without tools only when upstream says tools unsupported and tool_choice is not required
# true: disable fallback retry entirely
DISABLE_TOOL_FALLBACK=false

# App-server execution
# Codex desktop app is optional. The proxy only needs `codex` CLI + `codex login`.
# Maximum time (seconds) to wait for a non-streaming turn to complete
APP_SERVER_TURN_TIMEOUT_SECS=300
# Maximum time (seconds) to wait for a single app-server JSON-RPC request/response.
# If unset, falls back to APP_SERVER_TURN_TIMEOUT_SECS, then 45 seconds.
CLAUDE_CODEX_PROXY_JSONRPC_TIMEOUT_SECS=300

# Session limits
CLAUDE_CODEX_PROXY_MAX_SESSIONS=256
CLAUDE_CODEX_PROXY_JOBS_JSONL=./data/jobs.jsonl
CLAUDE_CODEX_PROXY_SESSIONS_JSONL=./data/sessions.jsonl

# Account auto-sync
# true: before dispatch, periodically rescan discovered auth files and mirror fresher auth
#       into older aliases for the same account_id/email
# false: only manual Scan / POST /api/accounts/sync updates the pool
CLAUDE_CODEX_PROXY_ACCOUNT_AUTO_SYNC=true
CLAUDE_CODEX_PROXY_ACCOUNT_AUTO_SYNC_INTERVAL_SECS=30

# Explicit continuation flows and executor-owned follow-ups
CLAUDE_CODEX_PROXY_ENABLE_THREAD_REUSE=true
CLAUDE_CODEX_PROXY_THREAD_IDLE_SECS=1800
CLAUDE_CODEX_PROXY_THREAD_MAX_TURNS=8
